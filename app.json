{
  "expo": {
    "name": "magicEnghisApp",
    "slug": "magicEnghisApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/hat-wizard-solid.png",
    "scheme": "magicenghisapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/hat-wizard-solid.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/hat-wizard-solid.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.josueRodrigoFierroMorfin.magicEnghisApp"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/hat-wizard-solid.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/hat-wizard-solid.png",
          "imageWidth": 76
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "07f42cef-4c16-48ee-bd65-47d5a1b7903f"
      }
    },
    "owner": "josuemagico"
  }
}
